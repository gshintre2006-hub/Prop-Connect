# Copy this file to .env.local and fill in real values.

# Supabase — Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: whole-app auth gate. "false" opens the app up (only /account needs login).
# NEXT_PUBLIC_REQUIRE_AUTH=false

# Admin Console (/admin) — owner + partner tools for managing vendor stores,
# props and users across both platforms. Comma-separated allowlist of the
# email addresses allowed in. Not secret (access still needs a real session for
# that email); every /api/admin route re-checks server-side.
# NEXT_PUBLIC_ADMIN_EMAILS=owner@example.com,partner@example.com
#
# Required for the Admin Console to read users / bypass RLS. Supabase Dashboard
# -> Project Settings -> API -> "service_role" secret. SERVER-ONLY — never add a
# NEXT_PUBLIC_ prefix; mark it "Sensitive" in Vercel.
# SUPABASE_SERVICE_ROLE_KEY=

# Moodboard AI stylist. Without any key, /api/stylist falls back to a local
# attribute matcher. With a key it reads the uploaded space photos + brief.
# Gemini is preferred when both are set.
#   Gemini key (free): aistudio.google.com  ->  Get API key
# GEMINI_API_KEY=
#   optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
#   Claude key (fallback): console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: embedded Google map on store pages. Without it, the map area is a
# styled "open in Google Maps" link (directions + the nearby-stores filter
# still work — those use the browser's geolocation, no key needed).
# Enable the "Maps Embed API" for the key at console.cloud.google.com.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Optional: Razorpay checkout for UPI / card / net-banking. Without these, the
# online payment options complete the order in demo mode (no charge). Start
# with rzp_test_ keys from dashboard.razorpay.com -> Settings -> API Keys.
# The key id is public; the secret must stay server-only (no NEXT_PUBLIC_).
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
