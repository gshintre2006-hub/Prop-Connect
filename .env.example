# Copy this file to .env.local and fill in real values.

# Supabase — Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: whole-app auth gate. "false" opens the app up (only /account needs login).
# NEXT_PUBLIC_REQUIRE_AUTH=false

# Optional: moodboard AI stylist. Without this the stylist falls back to a
# local attribute matcher; with it, /api/stylist calls Claude with vision to
# read the uploaded space photos. Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-...
